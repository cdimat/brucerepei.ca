---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../config';
import { altFor, getWork } from '../lib/works';
import { abs, breadcrumbs, graph, personSchema } from '../lib/seo';
import portrait from '../assets/bruce-portrait.jpg';

const studioWork = getWork('the-first-light');

const jsonLd = graph(
  { '@type': 'ProfilePage', url: abs('/about/'), name: `About ${site.name}`, mainEntity: personSchema },
  breadcrumbs([{ name: 'About', path: '/about/' }]),
);

const education = [
  { place: 'University of Calgary', detail: 'MFA program, Theatre Design' },
  { place: 'McMaster University, Hamilton', detail: 'Fine Art and business' },
  { place: 'Ontario College of Art, Toronto', detail: 'Part-time art classes' },
  { place: 'Mohawk College, Hamilton', detail: 'Part-time art classes' },
];
---

<Base
  title="About the Artist"
  description="Canadian artist Bruce Repei studied fine art at McMaster University and theatre design at the University of Calgary, then spent 30 years as a head scenic artist."
  ogType="profile"
  jsonLd={jsonLd}
>
  <PageIntro eyebrow="About the artist" title="Bruce Repei" />

  <section class="wrap bio">
    <figure class="portrait" data-reveal>
      <Picture src={portrait} alt="Portrait of Bruce Repei" widths={[300, 399]} sizes="(max-width: 800px) 70vw, 320px" formats={['avif', 'webp']} />
    </figure>

    <div class="text">
      <p class="lead">
        Canadian artist Bruce Repei studied Fine Art and business at university in the US and at McMaster University
        in Hamilton, Ontario, followed by part-time art classes at Mohawk College and the Ontario College of Art in
        Toronto. He later completed an MFA program in Theatre Design at the University of Calgary.
      </p>
      <p>
        He spent thirty years of his career working commercially in the professional theatre business as a Head
        Scenic Artist and Designer. He headed scenic art departments in regional theatres as well as in large
        commercial scenic companies, with thirty Head Scenic credits on Broadway as well as for <em>The Lion King</em>
        (Toronto and Los Angeles productions), <em>Mamma Mia!</em> (Toronto and US productions) and{' '}
        <em>The Lord of the Rings</em> (Toronto and London). His design and art direction work spans regional
        theatre, Princess Cruises and Paramount Theme Parks.
      </p>
      <p>
        Bruce maintains a studio on James Street North in Hamilton, Ontario, where he pursues painting in various
        mediums. He has taught painting and stagecraft at the college level, and currently teaches painting classes
        and workshops.
      </p>
      <div class="actions">
        <a class="btn" href="/theatre/">The theatre years</a>
        <a class="btn btn--ghost" href="/contact/">Contact Bruce</a>
      </div>
    </div>
  </section>

  <section class="section wrap facts">
    <div>
      <p class="eyebrow">Education</p>
      <ul class="list">
        {education.map((e) => <li><span class="place">{e.place}</span><span class="detail">{e.detail}</span></li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow">Teaching</p>
      <ul class="list">
        <li><span class="place">Painting classes &amp; workshops</span><span class="detail">Current, Hamilton studio</span></li>
        <li><span class="place">Painting and stagecraft</span><span class="detail">College level</span></li>
      </ul>
      <p class="eyebrow studio-label">Studio</p>
      <ul class="list">
        <li><span class="place">James Street North</span><span class="detail">Hamilton, Ontario</span></li>
      </ul>
    </div>
  </section>

  <section class="wrap quote-band" data-reveal>
    <a href={`/work/${studioWork.slug}/`} class="quote-art">
      <Picture src={studioWork.image} alt={altFor(studioWork)} widths={[480, 720, 900]} sizes="(max-width: 800px) 100vw, 50vw" formats={['avif', 'webp']} />
    </a>
    <div>
      <p class="eyebrow">In the studio</p>
      <blockquote>
        <p>{studioWork.description}</p>
        <footer>On <a href={`/work/${studioWork.slug}/`}><em>{studioWork.title}</em></a></footer>
      </blockquote>
    </div>
  </section>
</Base>

<style>
  .bio {
    display: grid;
    grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .portrait {
    margin: 0;
    position: sticky;
    top: 6.5rem;
  }
  .portrait :global(img) {
    width: 100%;
    border-radius: var(--radius);
    filter: saturate(0.85);
  }
  .text {
    max-width: 40em;
  }
  .text p {
    color: var(--ink-soft);
  }
  .lead {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.3;
    color: var(--ink) !important;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem clamp(2rem, 6vw, 6rem);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .place {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .detail {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .studio-label {
    margin-top: 2.5rem;
  }
  .quote-band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .quote-art :global(img) {
    width: 100%;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.3;
  }
  blockquote footer {
    color: var(--muted);
    font-size: 0.875rem;
  }
  @media (max-width: 800px) {
    .bio,
    .facts,
    .quote-band {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: static;
      max-width: 260px;
    }
  }
</style>
