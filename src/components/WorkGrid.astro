---
import { Picture } from 'astro:assets';
import { altFor, ratio, type Work } from '../lib/works';

interface Props {
  works: Work[];
  /** Target row height in px on desktop; rows flex to fill the width. */
  rowHeight?: number;
  /** Loads the first few images eagerly (for grids at the top of the page). */
  eager?: number;
}

const { works, rowHeight = 220, eager = 0 } = Astro.props;
---

<ul class="grid" style={`--row: ${rowHeight}px`}>
  {
    works.map((work, i) => (
      <li class="item" style={`--r: ${ratio(work).toFixed(4)}`}>
        <a href={`/work/${work.slug}/`}>
          <div class="frame">
            <Picture
              src={work.image}
              alt={altFor(work)}
              widths={[320, 480, 640, 900]}
              sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw"
              formats={['avif', 'webp']}
              loading={i < eager ? 'eager' : 'lazy'}
              style={`view-transition-name: work-${work.slug}`}
            />
          </div>
          <div class="caption">
            <span class="title">{work.title}</span>
            {work.medium && <span class="medium">{work.medium}</span>}
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 2.4vw, 2.25rem) clamp(1rem, 2vw, 1.75rem);
  }
  /* Keep the last row from stretching its few items too wide. */
  .grid::after {
    content: '';
    flex-grow: 999999;
  }
  .item {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
    min-width: 0;
  }
  .item a {
    display: block;
    text-decoration: none;
  }
  .frame {
    overflow: hidden;
    background: var(--line);
    aspect-ratio: var(--r);
    border-radius: var(--radius);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease),
      filter 0.5s;
  }
  .item a:hover .frame :global(img) {
    transform: scale(1.025);
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-top: 0.8rem;
  }
  .title {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .medium {
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .item {
      flex-basis: 100%;
    }
  }
</style>
