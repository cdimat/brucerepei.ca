---
import { nav, site } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <div>
      <a href="/" class="brand">{site.name}</a>
      <p class="muted">Painter &amp; scenic artist<br />{site.location}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="label">Prints</p>
      <p class="muted">
        Prints, canvases and more are available through{' '}
        <a href={site.faaProfile} target="_blank" rel="noopener">Fine Art America</a>.
      </p>
      {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>
  </div>
  <div class="wrap legal">
    <p>&copy; {year} {site.name}. All artwork images are copyright of the artist.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr;
    gap: 2.5rem;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.9rem;
    text-decoration: none;
    line-height: 1;
    display: inline-block;
    margin-bottom: 0.9rem;
  }
  .muted {
    color: var(--muted);
  }
  .label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  ul a {
    text-decoration: none;
  }
  ul a:hover {
    text-decoration: underline;
  }
  .legal {
    margin-top: 3rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8rem;
  }
  .legal p {
    margin: 0;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
